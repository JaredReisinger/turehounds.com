{
  "name": "turehounds.com",
  "private": true,
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "author": "Jared Reisinger",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "clean": "rimraf _js _site @types/@11ty",
    "prebuild": "npm-run-all -l -p :prebuild:code :prebuild:data",
    ":prebuild:code": "tsc --build",
    ":prebuild:data": "npm-run-all -l -p :prebuild:data:*",
    ":prebuild:data:plugins": "cpy --cwd . --dot 'plugins/**/*' '!**/*.{js,ts}' './_js/plugins'",
    ":prebuild:data:src": "cpy --cwd . --dot 'src/**/*' '!**/*.{js,ts}' './_js/src'",
    "build": "npm-run-all -l -p css:prod eleventy:prod -s build:data",
    "build:data": "npm-run-all -l -p search:build titles:build",
    "build:dev": "npm-run-all -l -p css eleventy -s build:data",
    "prebuild:dev": "npm run prebuild",
    "start": "npm-run-all -l --parallel css eleventy",
    "dev": "npm-run-all -l build:dev --parallel css:dev src:dev eleventy:dev",
    "src:dev": "monex --watch 'src' --ignore '**/*.{js,ts}' --delay 250 --exec 'npm::prebuild:data:src'",
    "css": "tailwindcss --input _js/src/static/css/tailwind.css --output _site/static/css/style.css",
    "css:dev": "npm run css -- --watch",
    "css:prod": "npm run css -- --minify",
    "eleventy": "eleventy --config ./_js/.eleventy.js",
    "eleventy:prod": "cross-env NODE_ENV=production npm run eleventy",
    "eleventy:dev": "npm run eleventy -- --serve --watch --ignore-initial",
    "eleventy:debug": "cross-env DEBUG=Eleventy* npm run eleventy -- --dryrun",
    "preeleventy:debug": "npm run prebuild",
    "### NOTE": "If the search/titles build logic ran straight from TS, we wouldn't have to 'build' it first",
    "search:build": "node _js/tools/build_search_index.js",
    "search:test": "node _js/tools/test_search_index.js",
    "titles:build": "node _js/tools/build_title_map.js",
    "titles:test": "npm run prebuild && node _js/tools/test_title_map.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-upgrade-help": "^3.0.2",
    "@shopify/prettier-plugin-liquid": "^1.10.2",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/11ty__eleventy-img": "^4.0.0",
    "@types/debug": "^4.1.13",
    "@types/html-minifier": "^4.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "@types/lunr": "^2.3.7",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "11ty.ts": "^0.0.7",
    "alpinejs": "^3.15.9",
    "bigger-picture": "^1.1.20",
    "cheerio": "^1.2.0",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "debug": "^4.4.3",
    "exif-reader": "^2.0.3",
    "glob": "^13.0.6",
    "heroicons": "^2.2.0",
    "html-minifier": "^4.0.0",
    "lodash": "^4.17.23",
    "lunr": "^2.3.9",
    "luxon": "^3.7.2",
    "monex": "^2.2.1",
    "node-window-polyfill": "^1.0.4",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "photoswipe": "^5.4.4",
    "photoswipe-dynamic-caption-plugin": "^1.2.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "watcher": "^2.3.1",
    "yaml": "^2.8.3"
  }
}
