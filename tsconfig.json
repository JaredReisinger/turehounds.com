{
  "include": ["./src/**/*", "./*", "./.*", "./plugins/**/*", "./tools/**/*"],
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",

    "rootDir": ".",
    "outDir": "./_js",

    // include our generated/hand-coded types.
    "typeRoots": ["@types", "node_modules/@types"],
    "types": [
      "eleventy-navigation",
    ],

    "allowJs": false,
    "checkJs": false,

    "removeComments": true,
    "declaration": false,
    "declarationMap": false,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,

    "skipLibCheck": true
  }
}
